<Window x:Class="DragDropTreeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:DragDropTreeApp"
        Title="Word to TreeView" Height="600" Width="800">

    <Window.Resources>
        <!-- Converter để lấy ảnh từ ImagePath -->
        <local:ImagePathToImageSourceConverter x:Key="ImagePathToImageSourceConverter"/>

        <!-- Converter để ẩn hiện ảnh nếu không có đường dẫn -->
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel>
        <Button DockPanel.Dock="Top" Click="OpenFile_Click" Content="📂 Mở file Word" Height="40"/>

        <TreeView x:Name="TreeDoc" Margin="10">
            <TreeView.ItemTemplate>
                <!--<HierarchicalDataTemplate ItemsSource="{Binding Children}">-->
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image 
                            Margin="2"
                            MaxHeight="200"
                            Stretch="Uniform"
                            Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}">

                            <Image.Source>
                                <Binding Path="ImagePath" Converter="{StaticResource ImagePathToImageSourceConverter}" />
                            </Image.Source>
                        </Image>

                        <TextBlock Text="{Binding Title}" Margin="5"/>
                    </StackPanel>
                    <!--</HierarchicalDataTemplate>-->
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>


